<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezExamen.Views.resumen"
             Title="Resumen">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Label x:Name="lblUsuarioConectado" FontAttributes="Italic" />

            <!-- Estilo Global Aplicado -->
            <Label Text="RESUMEN" 
                   Style="{StaticResource TituloSeccionStyle}" />

            <!-- Grid (9 Filas × 2 Columnas) -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" 
                  ColumnDefinitions="Auto, *" 
                  RowSpacing="8" 
                  ColumnSpacing="10">

                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" />

                <Label Text="Apellido" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" />

                <Label Text="Edad" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" />

                <Label Text="Fecha de inicio" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblFechaInicio" Grid.Row="3" Grid.Column="1" />

                <Label Text="Plan" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblPlan" Grid.Row="4" Grid.Column="1" />

                <Label Text="Casillero (Sí/No)" Grid.Row="5" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblCasillero" Grid.Row="5" Grid.Column="1" />

                <Label Text="Monto Inicial" Grid.Row="6" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblMontoInicial" Grid.Row="6" Grid.Column="1" />

                <Label Text="Pago mensual" Grid.Row="7" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblPagoMensual" Grid.Row="7" Grid.Column="1" />

                <Label Text="Pago Total" Grid.Row="8" Grid.Column="0" FontAttributes="Bold" />
                <Label x:Name="lblPagoTotal" Grid.Row="8" Grid.Column="1" />
            </Grid>

            <!-- Botones requeridos -->
            <Button Text="exportar en txt" Clicked="OnExportarTxtClicked" />
            <Button Text="Cerrar sesión" Clicked="OnCerrarSesionClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>