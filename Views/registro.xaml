<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezExamen.Views.registro"
             Title="Registro">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <Label x:Name="lblUsuarioConectado" FontAttributes="Italic" />

          
            <Label Text="REGISTRO" 
                   Style="{StaticResource TituloSeccionStyle}" />

            <Grid RowDefinitions="Auto, Auto" 
                  ColumnDefinitions="*, *, *" 
                  RowSpacing="10" 
                  ColumnSpacing="10">

                <Label Text="Nombre" Grid.Row="0" Grid.Column="0" HorizontalTextAlignment="Center"/>
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1" HorizontalTextAlignment="Center"/>
                <Label Text="Edad" Grid.Row="0" Grid.Column="2" HorizontalTextAlignment="Center"/>

                <Entry x:Name="txtNombre" Grid.Row="1" Grid.Column="0" Placeholder="Ingresar Nombre" />
                <Entry x:Name="txtApellido" Grid.Row="1" Grid.Column="1" Placeholder="Ingresar Apellido" />
                <Entry x:Name="txtEdad" Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Placeholder="≥ 16" />
            </Grid>


            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" 
                  ColumnDefinitions="Auto, *" 
                  RowSpacing="10" 
                  ColumnSpacing="10">

                <Label Text="Fecha de inicio" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                <DatePicker x:Name="dpFechaInicio" Grid.Row="0" Grid.Column="1"/>

                <Label Text="Plan" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
                <Picker x:Name="pickerPlan" Grid.Row="1" Grid.Column="1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Casillero" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
                <Picker x:Name="pickerCasillero" Grid.Row="2" Grid.Column="1" Title="Seleccione">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Sí</x:String>
                            <x:String>No</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Monto Inicial" Grid.Row="3" Grid.Column="0" VerticalOptions="Center"/>
                <Entry x:Name="txtMontoInicial" Grid.Row="3" Grid.Column="1" Keyboard="Numeric" Placeholder="120 - 600" />

                <Button Text="Calcular Pago mensual" Grid.Row="4" Grid.Column="0" Clicked="OnCalcularPagoClicked"/>
                <Entry x:Name="txtPagoMensual" Grid.Row="4" Grid.Column="1" IsReadOnly="True" />
            </Grid>

            <Button Text="Ver Resumen" Clicked="OnVerResumenClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>