<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="afernandezExamen.Views.login"
             Title="Login">

    <ScrollView>
        <StackLayout Spacing="10" Padding="20">
            <Image Source="gym.jpg" 
                   HeightRequest="100" 
                   HorizontalOptions="Center" />

            <!-- Estilo Global Aplicado -->
            <Label Text="GIMNASIO" 
                   Style="{StaticResource TituloLoginStyle}" />

            <Grid RowDefinitions="Auto, Auto, Auto" 
                  ColumnDefinitions="Auto, *" 
                  RowSpacing="10" 
                  ColumnSpacing="10">

                <Label Text="Usuario:" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />
                <Entry x:Name="txtUsuario" Grid.Row="0" Grid.Column="1" />

                <Label Text="Contraseña:" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                <Entry x:Name="txtPassword" Grid.Row="1" Grid.Column="1" IsPassword="True" />

                <Button Text="Iniciar sesión" 
                        Grid.Row="2" 
                        Grid.Column="0" 
                        Grid.ColumnSpan="2" 
                        Clicked="OnLoginClicked" />
            </Grid>

            <!-- Botón Acerca de que despliega la alerta emergente -->
            <Button Text="Acerca de" 
                    Clicked="OnAcercaDeClicked" />
        </StackLayout>
    </ScrollView>
</ContentPage>